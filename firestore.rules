rules_version = '2';
// Pick Tonight: public app, anonymous sign-in, strict household isolation. See src/sync/README.md.
//
// Membership: households/{hid} holds `uids` (phone uid -> member id) and `owners` (member id -> the one phone
// that currently is that member). A phone counts only while owners[uids[uid]] == uid, so taking a member over
// from a new phone (owners[m] = newUid) instantly locks the old phone out.
// Outsiders can do exactly two things: read one invite by its exact code, and join (one atomic batch that
// uses the invite up and adds themselves). Nothing can be listed. Unknown paths are denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hhPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    // h = the household document's data.
    function liveMember(h) {
      return request.auth.uid in h.uids
        && h.owners.get(h.uids[request.auth.uid], '') == request.auth.uid;
    }

    function isMember(hid) {
      return signedIn() && liveMember(get(hhPath(hid)).data);
    }

    // Members may write household content unless "Delete everything" is under way (then only deletes).
    function canWrite(hid) {
      let h = get(hhPath(hid)).data;
      return signedIn() && liveMember(h) && !h.get('deleting', false);
    }

    function canWriteMemberDoc(hid, mid) {
      let h = get(hhPath(hid)).data;
      return signedIn() && liveMember(h) && !h.get('deleting', false) && mid in h.members;
    }

    // ---- households ------------------------------------------------------------
    match /households/{hid} {
      // A household that does not exist reads as missing (so phones can tell "deleted" from "removed").
      allow get: if signedIn() && (resource == null || liveMember(resource.data));
      allow list: if false;

      allow create: if signedIn()
        && hid.matches('[A-Za-z0-9]{20}')
        && validCreate(request.resource.data);

      allow update: if signedIn()
        && (memberUpdate(resource.data, request.resource.data)
            || joinUpdate(hid, resource.data, request.resource.data));

      allow delete: if signedIn() && liveMember(resource.data);

      function validCreate(n) {
        let uid = request.auth.uid;
        return n.keys().hasOnly(['createdAt', 'nextId', 'members', 'names', 'owners', 'uids'])
          && n.keys().hasAll(['createdAt', 'nextId', 'members', 'names', 'owners', 'uids'])
          && n.createdAt == request.time
          && n.nextId == 2
          && n.members.keys().hasOnly(['m1'])
          && n.members.size() == 1
          && n.members['m1'].keys().hasOnly(['name', 'joinedAt'])
          && n.members['m1'].name is string
          && n.members['m1'].name.size() >= 1
          && n.members['m1'].name.size() <= 20
          && n.members['m1'].joinedAt is int
          && n.names.size() == 1
          && n.names['n:' + n.members['m1'].name.lower()] == 'm1'
          && n.owners.size() == 1
          && n.owners['m1'] == uid
          && n.uids.size() == 1
          && n.uids[uid] == 'm1';
      }

      // A current member renames, removes a member, unpairs a phone, tidies stale phone entries,
      // points at a new invite, or starts the deletion. Members are never ADDED or taken over here.
      function memberUpdate(o, n) {
        return liveMember(o)
          && !o.get('deleting', false)
          && n.diff(o).affectedKeys().hasOnly(['members', 'names', 'owners', 'uids', 'inviteCode', 'deleting'])
          && n.members.size() >= 1
          && n.members.size() <= 4
          && n.names.size() == n.members.size()
          && n.members.diff(o.members).addedKeys().size() == 0
          && n.owners.diff(o.owners).addedKeys().size() == 0
          && n.owners.diff(o.owners).changedKeys().size() == 0
          && n.uids.diff(o.uids).addedKeys().size() == 0
          && n.uids.diff(o.uids).changedKeys().size() == 0
          && (!('deleting' in n) || n.deleting == true)
          && (!('inviteCode' in n) || (n.inviteCode is string && n.inviteCode.size() == 6));
      }

      // An outsider joins with the household's current invite, in the same batch that marks it used.
      function joinUpdate(hid, o, n) {
        let uid = request.auth.uid;
        let ip = /databases/$(database)/documents/invites/$(o.inviteCode);
        return 'inviteCode' in o
          && !o.get('deleting', false)
          && (!(uid in o.uids) || o.owners.get(o.uids[uid], '') != uid)
          && n.diff(o).affectedKeys().hasOnly(['members', 'names', 'owners', 'uids', 'nextId'])
          && n.uids.size() <= 16
          && n.uids.diff(o.uids).affectedKeys().hasOnly([uid])
          && n.uids.diff(o.uids).affectedKeys().size() == 1
          && get(ip).data.hid == hid
          && get(ip).data.used == false
          && request.time < get(ip).data.createdAt + duration.value(24, 'h')
          && getAfter(ip).data.used == true
          && getAfter(ip).data.usedBy == uid
          && (joinNew(o, n, uid) || joinReclaim(o, n, uid));
      }

      function joinNew(o, n, uid) {
        let nid = 'm' + string(o.nextId);
        return n.nextId == o.nextId + 1
          && o.nextId <= 999
          && o.members.size() < 4
          && n.members.diff(o.members).affectedKeys().hasOnly([nid])
          && n.members.diff(o.members).addedKeys().size() == 1
          && n.members[nid].keys().hasOnly(['name', 'joinedAt'])
          && n.members[nid].name is string
          && n.members[nid].name.size() >= 1
          && n.members[nid].name.size() <= 20
          && n.members[nid].joinedAt is int
          && n.names.diff(o.names).affectedKeys().size() == 1
          && n.names.diff(o.names).addedKeys().size() == 1
          && n.names['n:' + n.members[nid].name.lower()] == nid
          && n.owners.diff(o.owners).affectedKeys().hasOnly([nid])
          && n.owners.diff(o.owners).affectedKeys().size() == 1
          && n.owners[nid] == uid
          && n.uids[uid] == nid;
      }

      // "I'm already a member": take over an existing member from this phone.
      function joinReclaim(o, n, uid) {
        return n.nextId == o.nextId
          && n.members == o.members
          && n.names == o.names
          && n.owners.diff(o.owners).affectedKeys().size() == 1
          && n.owners.diff(o.owners).removedKeys().size() == 0
          && n.owners.diff(o.owners).affectedKeys().hasOnly(o.members.keys())
          && n.owners.diff(o.owners).affectedKeys().hasOnly([n.uids[uid]])
          && n.owners[n.uids[uid]] == uid;
      }
    }

    // ---- everything inside a household: members only -----------------------------
    // data/shared and data/{memberId}
    match /households/{hid}/data/{docId} {
      allow read, delete: if isMember(hid);
      allow create, update: if
        (docId == 'shared' && canWrite(hid) && validShared(request.resource.data))
        || (docId.matches('m[0-9]{1,3}') && canWriteMemberDoc(hid, docId) && validMemberDoc(request.resource.data));

      function validShared(d) {
        return d.keys().hasOnly(['settings', 'ours'])
          && d.get('ours', {}).size() <= 1000
          && d.get('settings', {}) is map
          && d.get('settings', {}).get('plans', {}).size() <= 80;
      }

      function validMemberDoc(d) {
        return d.keys().hasOnly(['profile', 'never', 'notTonight', 'watch'])
          && d.get('never', {}).size() <= 3000
          && d.get('notTonight', {}).size() <= 1500
          && d.get('watch', {}).size() <= 1000
          && d.get('profile', {}) is map
          && d.get('profile', {}).get('favorites', []).size() <= 40
          && d.get('profile', {}).get('taste', {}).get('keywords', {}).size() <= 400;
      }
    }

    // seenx/{memberId}_{0..7}: watched titles (JSON string per title)
    match /households/{hid}/seenx/{docId} {
      allow read, delete: if isMember(hid);
      allow create, update: if docId.matches('m[0-9]{1,3}_[0-7]')
        && canWriteMemberDoc(hid, docId.split('_')[0])
        && request.resource.data.keys().hasOnly(['e'])
        && request.resource.data.get('e', {}).size() <= 2500;
    }

    // months/{YYYY-MM}: the Matches tab
    match /households/{hid}/months/{docId} {
      allow read, delete: if isMember(hid);
      allow create, update: if docId.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && canWrite(hid)
        && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.get('entries', {}).size() <= 1500;
    }

    // sessions/current: the one open Together session
    match /households/{hid}/sessions/{docId} {
      allow read, delete: if isMember(hid);
      allow create, update: if docId == 'current'
        && canWrite(hid)
        && request.resource.data.keys().hasOnly(['id', 'startedBy', 'request', 'deck', 'joined', 'yes', 'passed', 'matches', 'status', 'createdAt'])
        && request.resource.data.deck.size() <= 400
        && request.resource.data.joined.size() <= 4
        && request.resource.data.yes.size() <= 4
        && request.resource.data.passed.size() <= 4
        && request.resource.data.matches.size() <= 400;
    }

    // ---- invites: 6-character one-time codes ---------------------------------------
    match /invites/{code} {
      // Reading one invite by its exact code is the "preview". Listing is impossible.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['hid', 'createdBy', 'createdAt', 'used', 'members', 'full', 'nextId'])
        && request.resource.data.keys().hasAll(['hid', 'createdBy', 'createdAt', 'used', 'members', 'full', 'nextId'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.used == false
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 4
        && request.resource.data.full is bool
        && request.resource.data.nextId is int
        && isMember(request.resource.data.hid)
        && getAfter(hhPath(request.resource.data.hid)).data.inviteCode == code;

      allow update: if signedIn() && (redeem() || refresh());

      allow delete: if signedIn() && isMember(resource.data.hid);

      // Use the code up, once, while fresh, in the same batch that adds this phone to the household.
      function redeem() {
        let o = resource.data;
        let n = request.resource.data;
        return o.used == false
          && request.time < o.createdAt + duration.value(24, 'h')
          && n.diff(o).affectedKeys().hasOnly(['used', 'usedBy', 'members', 'full'])
          && n.used == true
          && n.usedBy == request.auth.uid
          && n.members.size() == 0
          && request.auth.uid in getAfter(hhPath(o.hid)).data.uids;
      }

      // A member keeps the preview snapshot fresh after a rename / removal.
      function refresh() {
        let o = resource.data;
        let n = request.resource.data;
        return isMember(o.hid)
          && n.diff(o).affectedKeys().hasOnly(['members', 'full', 'nextId'])
          && n.members.size() <= 4;
      }
    }
  }
}
